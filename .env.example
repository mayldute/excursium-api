# =============================================================================
# Application
# =============================================================================

APP__APP_NAME=Excursium API
APP__DEBUG=True
APP__ENV=development


# =============================================================================
# PostgreSQL
# =============================================================================

DATABASE__DB_LOGIN=excursium
DATABASE__DB_PASS=excursium
DATABASE__DB_HOST=localhost
DATABASE__DB_PORT=5433
DATABASE__DB_NAME=excursium
DATABASE__DATABASE_URL=postgresql+asyncpg://excursium:excursium@localhost:5433/excursium


# =============================================================================
# JWT
# Generate a secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

JWT__JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT__JWT_ALGORITHM=HS256
JWT__JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# =============================================================================
# SMTP
# =============================================================================

SMTP__SMTP_SERVER=smtp.example.com
SMTP__SMTP_PORT=465
SMTP__SMTP_USERNAME=your-smtp-username
SMTP__SMTP_PASSWORD=your-smtp-password
SMTP__FROM_EMAIL=noreply@example.com


# =============================================================================
# MinIO
# =============================================================================

MINIO__MINIO_ENDPOINT=localhost:9000
MINIO__MINIO_ACCESS_KEY=minioadmin
MINIO__MINIO_SECRET_KEY=minioadmin
MINIO__MINIO_BUCKET_NAME=excursium
MINIO__MINIO_SECURE=False


# =============================================================================
# Google OAuth
# =============================================================================

GOOGLE__GOOGLE_CLIENT_ID=
GOOGLE__GOOGLE_CLIENT_SECRET=
GOOGLE__GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback


# =============================================================================
# Yandex OAuth
# =============================================================================

YANDEX__YANDEX_CLIENT_ID=
YANDEX__YANDEX_CLIENT_SECRET=
YANDEX__YANDEX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/yandex/callback
